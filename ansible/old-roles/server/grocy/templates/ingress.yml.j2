apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: {{ grocy_ingress_name }}
  namespace: {{ grocy_namespace }}
  annotations:
    traefik.ingress.kubernetes.io/router.entrypoints: "web,websecure"
    traefik.ingress.kubernetes.io/router.tls: "true"
    cert-manager.io/cluster-issuer: letsencrypt-prod
spec:
  ingressClassName: {{ grocy_ingress_class }}
  rules:
    - host: {{ grocy_host }}
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: {{ grocy_service_name }}
                port:
                  number: {{ grocy_service_port }}
  tls:
    - hosts:
        - {{ grocy_host }}
      secretName: {{ grocy_tls_secret }}
