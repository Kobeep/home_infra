apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: adguard-ingress
  namespace: default
  annotations:
    kubernetes.io/ingress.class: traefik
spec:
  ingressClassName: traefik
  rules:
    - host: adguard.kobeeq.eu
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: adguardhome-web
                port:
                  number: 3000