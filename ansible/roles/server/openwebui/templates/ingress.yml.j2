apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: openwebui-ingress
  namespace: {{ ollama_namespace }}
  annotations:
    kubernetes.io/ingress.class: traefik
spec:
  rules:
    - host: "{{ openwebui_ingress_host }}"
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: openwebui
                port:
                  number: 8080
