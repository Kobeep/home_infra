/**
 * Jenkins Agent Management Pipeline
 * 
 * Manages Jenkins slave node connectivity and automatically starts
 * the slave agent if it's offline. Uses secure credential management
 * instead of hardcoded secrets.
 * 
 * Features:
 * - Secure agent secret management via Jenkins credentials
 * - Automatic node status detection
 * - Robust error handling and logging
 * - Professional CI/CD practices
 * - Node health verification
 * 
 * @version 2.0.0
 * @author Jenkins CI
 */

// Load shared library from current repository
library identifier: 'homeInfraUtils@main', retriever: modernSCM([
    $class: 'GitSCMSource',
    remote: 'https://github.com/Kobeep/home_infra.git'
]) _

pipeline {
    agent any

    environment {
        // Pipeline metadata
        PIPELINE_VERSION = '2.0.0'
        PIPELINE_NAME = 'Jenkins Agent Management'
        
        // Agent configuration
        AGENT_NAME = 'slave'
        AGENT_WORKDIR = '/var/jenkins_home'
        
        // Connection configuration
        CONNECTION_TIMEOUT = '30'
        MAX_RETRY_ATTEMPTS = '3'
    }

    options {
        // Build configuration
        buildDiscarder(logRotator(numToKeepStr: '50'))
        timeout(time: 15, unit: 'MINUTES')
        skipStagesAfterUnstable()
        
        // Enhanced logging
        ansiColor('xterm')
        timestamps()
    }

    triggers {
        // Check node status every 15 minutes during business hours
        cron('H/15 8-18 * * 1-5')
    }

    stages {
        stage('Initialize Agent Management') {
            steps {
                script {
                    echo "🚀 Starting ${env.PIPELINE_NAME} v${env.PIPELINE_VERSION}"
                    echo "🤖 Target Agent: ${env.AGENT_NAME}"
                    echo "📅 Check Time: ${new Date().format('yyyy-MM-dd HH:mm:ss UTC')}"
                    
                    // Validate Jenkins environment
                    if (!Jenkins.instance) {
                        error "❌ Jenkins instance not available"
                    }
                    
                    echo "✅ Agent management initialization completed"
                }
            }
        }

        stage('Check Agent Status') {
            steps {
                script {
                    try {
                        echo "🔍 Checking status of agent: ${env.AGENT_NAME}"
                        
                        def node = Jenkins.instance.getNode(env.AGENT_NAME)
                        if (!node) {
                            error "❌ Agent '${env.AGENT_NAME}' not found in Jenkins configuration"
                        }
                        
                        def computer = node.toComputer()
                        if (!computer) {
                            error "❌ Unable to get computer instance for agent '${env.AGENT_NAME}'"
                        }
                        
                        def isOnline = computer.isOnline()
                        def isAcceptingTasks = computer.isAcceptingTasks()
                        def isIdle = computer.isIdle()
                        
                        env.AGENT_ONLINE = isOnline.toString()
                        env.AGENT_ACCEPTING_TASKS = isAcceptingTasks.toString()
                        env.AGENT_IDLE = isIdle.toString()
                        
                        echo "📊 Agent Status Report:"
                        echo "   Online: ${isOnline}"
                        echo "   Accepting Tasks: ${isAcceptingTasks}"
                        echo "   Idle: ${isIdle}"
                        
                        if (isOnline) {
                            echo "✅ Agent is online and available"
                            env.AGENT_ACTION_REQUIRED = "false"
                        } else {
                            echo "⚠️  Agent is offline - startup required"
                            env.AGENT_ACTION_REQUIRED = "true"
                            
                            // Get offline cause if available
                            def offlineCause = computer.getOfflineCause()
                            if (offlineCause) {
                                echo "   Offline Cause: ${offlineCause.toString()}"
                            }
                        }
                        
                    } catch (Exception e) {
                        error "❌ Failed to check agent status: ${e.getMessage()}"
                    }
                }
            }
        }

        stage('Start Agent if Offline') {
            when {
                expression { env.AGENT_ACTION_REQUIRED == "true" }
            }
            steps {
                script {
                    try {
                        echo "🔧 Starting offline agent: ${env.AGENT_NAME}"
                        
                        withCredentials([
                            string(credentialsId: 'jenkins-agent-secret', variable: 'AGENT_SECRET'),
                            string(credentialsId: 'jenkins-master-url', variable: 'JENKINS_URL')
                        ]) {
                            
                            // Validate credentials
                            homeInfraUtils.validateParameters([
                                AGENT_SECRET: env.AGENT_SECRET,
                                JENKINS_URL: env.JENKINS_URL
                            ])
                            
                            echo "🚀 Launching Jenkins agent..."
                            echo "   URL: ${env.JENKINS_URL}"
                            echo "   Agent: ${env.AGENT_NAME}"
                            echo "   Work Directory: ${env.AGENT_WORKDIR}"
                            
                            // Start agent with secure credentials
                            def startCommand = """
                                nohup java -jar agent.jar \
                                    -url ${env.JENKINS_URL} \
                                    -secret ${env.AGENT_SECRET} \
                                    -name ${env.AGENT_NAME} \
                                    -webSocket \
                                    -workDir "${env.AGENT_WORKDIR}" \
                                    > agent.log 2>&1 &
                            """
                            
                            sh startCommand
                            
                            echo "✅ Agent startup command executed"
                        }
                        
                    } catch (Exception e) {
                        error "❌ Failed to start agent: ${e.getMessage()}"
                    }
                }
            }
        }

        stage('Verify Agent Connection') {
            when {
                expression { env.AGENT_ACTION_REQUIRED == "true" }
            }
            steps {
                script {
                    try {
                        echo "🔍 Verifying agent connection..."
                        
                        def maxAttempts = env.MAX_RETRY_ATTEMPTS as Integer
                        def connectionVerified = false
                        
                        for (int attempt = 1; attempt <= maxAttempts; attempt++) {
                            echo "📡 Connection attempt ${attempt}/${maxAttempts}..."
                            
                            // Wait before checking
                            sleep(time: 10, unit: 'SECONDS')
                            
                            def node = Jenkins.instance.getNode(env.AGENT_NAME)
                            def computer = node?.toComputer()
                            
                            if (computer?.isOnline()) {
                                connectionVerified = true
                                echo "✅ Agent successfully connected on attempt ${attempt}"
                                break
                            } else {
                                echo "⏳ Agent not yet online, waiting..."
                            }
                        }
                        
                        if (!connectionVerified) {
                            error "❌ Agent failed to connect after ${maxAttempts} attempts"
                        }
                        
                        env.AGENT_CONNECTION_VERIFIED = "true"
                        
                    } catch (Exception e) {
                        error "❌ Agent connection verification failed: ${e.getMessage()}"
                    }
                }
            }
        }

        stage('Test Agent Functionality') {
            when {
                anyOf {
                    expression { env.AGENT_CONNECTION_VERIFIED == "true" }
                    expression { env.AGENT_ACTION_REQUIRED == "false" }
                }
            }
            steps {
                script {
                    try {
                        echo "🧪 Testing agent functionality..."
                        
                        // Test that we can execute a job on the agent
                        node(env.AGENT_NAME) {
                            echo "🎯 Successfully executing on agent: ${env.AGENT_NAME}"
                            echo "📍 Node Name: ${env.NODE_NAME}"
                            echo "💻 Workspace: ${env.WORKSPACE}"
                            
                            // Basic system check
                            def systemInfo = sh(
                                script: "uname -a && df -h / | tail -1",
                                returnStdout: true
                            ).trim()
                            
                            echo "🖥️  System Information:"
                            systemInfo.split('\n').each { line ->
                                echo "   ${line}"
                            }
                        }
                        
                        echo "✅ Agent functionality test completed successfully"
                        
                    } catch (Exception e) {
                        error "❌ Agent functionality test failed: ${e.getMessage()}"
                    }
                }
            }
        }

        stage('Generate Agent Status Report') {
            steps {
                script {
                    try {
                        echo "📋 Generating agent status report..."
                        
                        def node = Jenkins.instance.getNode(env.AGENT_NAME)
                        def computer = node?.toComputer()
                        
                        def reportLines = []
                        reportLines.add("# Jenkins Agent Status Report - ${new Date().format('yyyy-MM-dd HH:mm:ss UTC')}")
                        reportLines.add("")
                        reportLines.add("## Agent Information:")
                        reportLines.add("- **Name**: ${env.AGENT_NAME}")
                        reportLines.add("- **Status**: ${computer?.isOnline() ? 'Online' : 'Offline'}")
                        reportLines.add("- **Accepting Tasks**: ${computer?.isAcceptingTasks() ?: 'Unknown'}")
                        reportLines.add("- **Idle**: ${computer?.isIdle() ?: 'Unknown'}")
                        
                        if (env.AGENT_ACTION_REQUIRED == "true") {
                            reportLines.add("- **Action Taken**: Agent was offline and startup was initiated")
                            reportLines.add("- **Connection Verified**: ${env.AGENT_CONNECTION_VERIFIED ?: 'false'}")
                        } else {
                            reportLines.add("- **Action Taken**: No action required - agent was already online")
                        }
                        
                        reportLines.add("")
                        reportLines.add("## Management Details:")
                        reportLines.add("- **Pipeline**: ${env.PIPELINE_NAME} v${env.PIPELINE_VERSION}")
                        reportLines.add("- **Build Number**: #${env.BUILD_NUMBER}")
                        reportLines.add("- **Duration**: ${currentBuild.durationString}")
                        
                        // Write report to file
                        writeFile file: 'agent-status-report.md', text: reportLines.join('\n')
                        
                        // Display report in console
                        echo "📊 Agent Status Report:"
                        reportLines.each { line -> echo line }
                        
                    } catch (Exception e) {
                        echo "⚠️  Failed to generate agent status report (non-critical): ${e.getMessage()}"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def duration = currentBuild.durationString.replace(' and counting', '')
                echo "📊 ${env.PIPELINE_NAME} completed in ${duration}"
                echo "📋 Build result: ${currentBuild.result ?: 'SUCCESS'}"
                echo "🤖 Agent: ${env.AGENT_NAME}"
                
                // Archive the agent status report
                if (fileExists('agent-status-report.md')) {
                    archiveArtifacts artifacts: 'agent-status-report.md', fingerprint: true
                }
            }
        }
        
        success {
            script {
                if (env.AGENT_ACTION_REQUIRED == "true") {
                    echo "✅ Agent management completed - offline agent was successfully started"
                } else {
                    echo "✅ Agent management completed - agent was already online"
                }
                echo "🎉 Agent ${env.AGENT_NAME} is now available for builds"
            }
        }
        
        failure {
            echo "❌ Agent management failed"
            echo "🔍 Check the logs above for detailed error information"
            echo "💡 Common issues:"
            echo "   - Agent JAR file not available"
            echo "   - Network connectivity problems"
            echo "   - Invalid agent credentials"
            echo "   - Jenkins master URL incorrect"
            echo "   - Agent already running on different process"
        }
        
        unstable {
            echo "⚠️  Agent management completed with warnings"
            echo "📋 Agent may be online but not fully functional"
        }
        
        cleanup {
            script {
                // Clean up sensitive environment variables
                env.AGENT_SECRET = null
                env.JENKINS_URL = null
                
                // Standard pipeline cleanup
                homeInfraUtils.cleanup()
                
                echo "🧹 Pipeline cleanup completed"
            }
        }
    }
}