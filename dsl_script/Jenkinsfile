/**
 * Home Infrastructure Deployment Pipeline - Main Orchestrator
 * 
 * This pipeline provides a unified interface for deploying Ansible playbooks
 * to both Linux and Windows hosts in the home infrastructure.
 * 
 * Features:
 * - Dynamic host and playbook selection based on target OS
 * - Secure credential management
 * - Comprehensive error handling and logging
 * - Professional CI/CD practices
 * 
 * @version 2.0.0
 * @author Jenkins CI
 */

@Library('homeInfraUtils') _

pipeline {
    agent { 
        label 'slave' 
    }

    parameters {
        choice(
            name: 'TARGET_OS', 
            choices: ['windows', 'linux'], 
            description: 'Select target operating system for deployment'
        )
    }

    environment {
        // Standard environment variables for home infrastructure
        INVENTORY_FILE = 'ansible/inventories/hosts.yml'
        PLAYBOOKS_DIR = 'ansible/playbooks'
        
        // Pipeline metadata
        PIPELINE_VERSION = '2.0.0'
        PIPELINE_NAME = 'Home Infrastructure Deployment'
    }

    options {
        // Build configuration
        buildDiscarder(logRotator(numToKeepStr: '10'))
        timeout(time: 30, unit: 'MINUTES')
        skipStagesAfterUnstable()
        
        // Security and cleanup
        ansiColor('xterm')
    }

    stages {
        stage('Initialize Pipeline') {
            steps {
                script {
                    echo "🚀 Starting ${env.PIPELINE_NAME} v${env.PIPELINE_VERSION}"
                    echo "📋 Target OS: ${params.TARGET_OS}"
                    echo "📁 Workspace: ${env.WORKSPACE}"
                    
                    // Validate Jenkins environment
                    if (!env.JENKINS_HOME) {
                        error "❌ Jenkins environment not properly configured"
                    }
                }
            }
        }

        stage('Checkout Repository') {
            steps {
                echo "📥 Checking out repository..."
                checkout scm
                
                script {
                    // Verify required files exist
                    def requiredFiles = [env.INVENTORY_FILE, env.PLAYBOOKS_DIR]
                    requiredFiles.each { file ->
                        if (!fileExists(file)) {
                            error "❌ Required file/directory not found: ${file}"
                        }
                    }
                    echo "✅ Repository checkout and validation completed"
                }
            }
        }

        stage('Dynamic Configuration Selection') {
            steps {
                script {
                    try {
                        echo "🔧 Configuring deployment options for ${params.TARGET_OS}..."
                        
                        // Get available hosts for the selected OS
                        def availableHosts = homeInfraUtils.getAvailableHosts(
                            env.INVENTORY_FILE, 
                            params.TARGET_OS
                        )
                        
                        // Get available playbooks
                        def availablePlaybooks = homeInfraUtils.getAvailablePlaybooks(
                            env.PLAYBOOKS_DIR
                        )
                        
                        // Prompt user for deployment configuration
                        def userSelection = input(
                            message: "Configure deployment for ${params.TARGET_OS}:",
                            parameters: [
                                [
                                    $class: 'ChoiceParameterDefinition',
                                    choices: availableHosts.join("\n"),
                                    description: 'Select target host from inventory',
                                    name: 'TARGET_HOST'
                                ],
                                [
                                    $class: 'ChoiceParameterDefinition',
                                    choices: availablePlaybooks.join("\n"),
                                    description: 'Select Ansible playbook to execute',
                                    name: 'PLAYBOOK'
                                ],
                                password(
                                    name: 'AUTH_PASS', 
                                    defaultValue: '', 
                                    description: "Authentication password (${params.TARGET_OS == 'windows' ? 'WinRM' : 'SSH'})"
                                )
                            ]
                        )
                        
                        // Validate user input
                        homeInfraUtils.validateParameters([
                            TARGET_HOST: userSelection.TARGET_HOST,
                            PLAYBOOK: userSelection.PLAYBOOK,
                            AUTH_PASS: userSelection.AUTH_PASS
                        ])
                        
                        // Store configuration as environment variables
                        env.TARGET_HOST = userSelection.TARGET_HOST
                        env.PLAYBOOK = userSelection.PLAYBOOK
                        env.AUTH_PASS = userSelection.AUTH_PASS
                        
                        echo "✅ Deployment configuration completed:"
                        echo "   Host: ${env.TARGET_HOST}"
                        echo "   Playbook: ${env.PLAYBOOK}"
                        echo "   Platform: ${params.TARGET_OS}"
                        
                    } catch (Exception e) {
                        error "❌ Failed to configure deployment options: ${e.getMessage()}"
                    }
                }
            }
        }

        stage('Trigger Downstream Deployment') {
            steps {
                script {
                    try {
                        echo "🎯 Triggering ${params.TARGET_OS} deployment pipeline..."
                        
                        def downstreamJob = ""
                        def deploymentParams = [
                            string(name: 'TARGET_HOST', value: env.TARGET_HOST),
                            string(name: 'PLAYBOOK', value: env.PLAYBOOK)
                        ]
                        
                        // Configure platform-specific parameters
                        if (params.TARGET_OS == 'windows') {
                            downstreamJob = "CD-Windows"
                            deploymentParams.add(password(name: 'WINRM_PASS', value: env.AUTH_PASS))
                        } else {
                            downstreamJob = "CD-Linux"
                            deploymentParams.add(password(name: 'SSH_PASS', value: env.AUTH_PASS))
                        }
                        
                        // Trigger downstream job with timeout
                        timeout(time: 20, unit: 'MINUTES') {
                            def downstreamBuild = build(
                                job: downstreamJob,
                                parameters: deploymentParams,
                                wait: true,
                                propagate: true
                            )
                            
                            echo "✅ Downstream deployment completed successfully"
                            echo "   Job: ${downstreamJob}"
                            echo "   Build Number: ${downstreamBuild.number}"
                            echo "   Duration: ${downstreamBuild.durationString}"
                        }
                        
                    } catch (Exception e) {
                        error "❌ Downstream deployment failed: ${e.getMessage()}"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def duration = currentBuild.durationString.replace(' and counting', '')
                echo "📊 ${env.PIPELINE_NAME} completed in ${duration}"
                echo "📋 Build result: ${currentBuild.result ?: 'SUCCESS'}"
                echo "🏠 Target: ${env.TARGET_HOST ?: 'Not selected'}"
                echo "📖 Playbook: ${env.PLAYBOOK ?: 'Not selected'}"
            }
        }
        
        success {
            echo "✅ Deployment orchestration completed successfully"
            echo "🎉 ${params.TARGET_OS} deployment to ${env.TARGET_HOST} was successful"
        }
        
        failure {
            echo "❌ Deployment orchestration failed"
            echo "🔍 Check the downstream job logs for detailed error information"
        }
        
        unstable {
            echo "⚠️  Deployment completed with warnings"
        }
        
        cleanup {
            script {
                // Clean up sensitive environment variables
                env.AUTH_PASS = null
                
                // Perform standard cleanup
                homeInfraUtils.cleanup()
                
                echo "🧹 Pipeline cleanup completed"
            }
        }
    }
}