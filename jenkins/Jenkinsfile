def banner(String msg, String color = '36') {
    echo "\u001B[1;${color}m===> ${msg}\u001B[0m"
}

pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: shell
    image: ubuntu:22.04
    command:
    - sleep
    args:
    - infinity
'''
            defaultContainer 'shell'
            retries 2
        }
    }

    options {
        disableConcurrentBuilds()
        ansiColor('xterm')
        timeout(time: 30, unit: 'MINUTES')
    }

    environment {
        ANSIBLE_FORCE_COLOR = 'true'
        ACTION          = "${params.ACTION}"
        PLAYBOOK        = "${params.PLAYBOOK}"
        KUBECTL_COMMAND = "${params.KUBECTL_COMMAND}"
        POD_NAME        = "${params.POD_NAME}"
    }

    stages {
        stage('Checkout') {
            steps {
                banner('Checking out repository', '34')
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                banner('Installing ansible, kubectl, and friends', '34')
                sh '''
                    set -eo pipefail
                    apt-get update && apt-get install -y --no-install-recommends ansible python3-pip curl ca-certificates

                    if ! command -v kubectl &> /dev/null; then
                        KUBECTL_VERSION=$(curl -L -s https://dl.k8s.io/release/stable.txt)
                        curl -LO "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/amd64/kubectl"
                        chmod +x kubectl
                        mv kubectl /usr/local/bin/kubectl
                    fi
                    kubectl version --client
                '''
            }
        }

        stage('Deploy to Server') {
            steps {
                banner('Testing SSH connection', '34')
                sshagent(credentials: ['serwer-ssh-key']) {
                    withCredentials([
                        sshUserPrivateKey(
                            credentialsId: 'serwer-ssh-key',
                            keyFileVariable: 'SSH_KEY',
                            usernameVariable: 'SSH_USER'
                        )
                    ]) {
                        sh '''
                            mkdir -p ~/.ssh && chmod 700 ~/.ssh
                            ssh-keyscan -H "${SERVER_IP}" >> ~/.ssh/known_hosts 2>/dev/null || true

                            ssh -i "${SSH_KEY}" -o StrictHostKeyChecking=accept-new "${SSH_USER}@${SERVER_IP}" "uptime"
                        '''
                    }
                }
            }
        }

        stage('Run selected action') {
            steps {
                script {
                    banner("ACTION: ${env.ACTION}", '35')

                    if (env.ACTION == 'Run Ansible Playbook') {
                        banner("Running playbook: ${env.PLAYBOOK}", '32')
                        withCredentials([
                            sshUserPrivateKey(
                                credentialsId: 'serwer-ssh-key',
                                keyFileVariable: 'SSH_KEY',
                                usernameVariable: 'SSH_USER'
                            ),
                            string(
                                credentialsId: 'ansible-vault-password',
                                variable: 'VAULT_PASS'
                            )
                        ]) {
                            try {
                                writeFile file: '.vault_pass', text: VAULT_PASS
                                sh '''
                                    ANSIBLE_ROLES_PATH=ansible/roles ansible-playbook "ansible/playbooks/${PLAYBOOK}" \
                                        -i ansible/inventory.yml \
                                        --vault-password-file .vault_pass \
                                        -e "ansible_user=${SSH_USER}" \
                                        -e "ansible_ssh_private_key_file=${SSH_KEY}" \
                                        -e "ansible_host=${SERVER_IP}"
                                '''
                            } finally {
                                sh 'rm -f .vault_pass'
                            }
                        }
                    } else if (env.ACTION == 'Execute Kubectl Command') {
                        banner("Running: kubectl ${env.KUBECTL_COMMAND}", '33')
                        if (env.KUBECTL_COMMAND == 'describe pod <pod-name>') {
                            if (!env.POD_NAME || env.POD_NAME.trim().isEmpty()) {
                                error("BŁĄD: Parameter POD_NAME is required for the 'describe pod' command!")
                            }
                            sh "kubectl describe pod ${env.POD_NAME}"
                        } else {
                            sh "kubectl ${env.KUBECTL_COMMAND}"
                        }
                    } else {
                        error("Unknown ACTION: ${env.ACTION}")
                    }

                    banner('Done!', '32')
                }
            }
        }
    }

}
