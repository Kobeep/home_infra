// Checkout the repo and run the selected action.
// Parameters (ACTION, PLAYBOOK, KUBECTL_COMMAND, POD_NAME) are injected by
// the seed job's Job DSL script — see seed-upstream.groovy.

pipeline {
    agent {
        kubernetes {
            yaml '''
apiVersion: v1
kind: Pod
spec:
  containers:
  - name: shell
    image: ubuntu
    command:
    - sleep
    args:
    - infinity
'''
            defaultContainer 'shell'
            retries 2
        }
    }

    options {
        disableConcurrentBuilds()
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Install dependencies') {
            steps {
                sh '''
                    apt-get update
                    apt-get install -y ansible python3-pip curl

                    curl -LO "https://dl.k8s.io/release/$(curl -L -s https://dl.k8s.io/release/stable.txt)/bin/linux/amd64/kubectl"
                    chmod +x kubectl
                    mv kubectl /usr/local/bin/kubectl
                    kubectl version --client
                '''
            }
        }

        stage('Run selected action') {
            steps {
                script {
                    echo "ACTION: ${params.ACTION}"

                    if (params.ACTION == 'Run Ansible Playbook') {
                        withCredentials([
                            usernamePassword(
                                credentialsId: 'server-machine',
                                usernameVariable: 'SSH_USER',
                                passwordVariable: 'SSH_PASS'
                            ),
                            string(
                                credentialsId: 'ansible-vault-password',
                                variable: 'VAULT_PASS'
                            )
                        ]) {
                            writeFile file: '.vault_pass', text: VAULT_PASS
                            sh '''
                                ANSIBLE_ROLES_PATH=ansible/roles ansible-playbook ansible/playbooks/${PLAYBOOK} \
                                    -i ansible/inventory.yml \
                                    --vault-password-file .vault_pass \
                                    -e ansible_user=${SSH_USER} \
                                    -e ansible_ssh_pass=${SSH_PASS}
                                rm -f .vault_pass
                            '''
                        }
                    } else if (params.ACTION == 'Execute Kubectl Command') {
                        if (params.KUBECTL_COMMAND == 'describe pod <pod-name>') {
                            sh "kubectl describe pod ${params.POD_NAME} -A"
                        } else {
                            sh "kubectl ${params.KUBECTL_COMMAND}"
                        }
                    } else {
                        error("Unknown ACTION: ${params.ACTION}")
                    }
                }
            }
        }
    }
}
