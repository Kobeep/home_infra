pipeline {
  agent { label 'slave' }

  environment {
    INVENTORY_FILE    = 'ansible/inventories/hosts.yml'
    HOST_NAME         = 'server'
    SSH_BASE          = '/var/jenkins_home/.ssh'
    REMOTE_KUBECONFIG = '/etc/rancher/k3s/k3s.yaml'
    HASS_LOCAL        = 'hass-config'
    DASHY_LOCAL       = 'dashy-config'
    GRAFANA_LOCAL     = 'grafana-config'
    JENKINS_BACKUP    = 'jenkins-pipelines-backup'
  }

  stages {
    stage('Checkout') {
      steps { 
        echo "📥 Checking out repository for backup operations..."
        checkout scm 
      }
    }

    stage('Parse Inventory') {
      steps {
        script {
          echo "🔍 Parsing inventory for host: ${env.HOST_NAME}"
          def inventoryOutput = sh(script: """
            chmod +x scripts/common/inventory-parser.py
            python3 scripts/common/inventory-parser.py "${env.INVENTORY_FILE}" "${env.HOST_NAME}"
          """, returnStdout: true).trim()
          
          def hostConfig = readJSON text: inventoryOutput
          env.REMOTE_HOST = hostConfig.ansible_host
          env.REMOTE_USER = hostConfig.ansible_user
          
          echo "➡ Target: ${env.REMOTE_USER}@${env.REMOTE_HOST}"
        }
      }
    }

    stage('Clean Old Configs') {
      steps {
        echo "🧹 Cleaning old configuration directories..."
        sh "rm -rf ${HASS_LOCAL} ${DASHY_LOCAL} ${GRAFANA_LOCAL} ${JENKINS_BACKUP}"
      }
    }

    stage('Backup Configurations') {
      steps {
        echo "💾 Running configuration backup via script..."
        sh '''
          chmod +x jf/scripts/backup_configs.sh
          ./jf/scripts/backup_configs.sh
        '''
      }
    }

    stage('Backup Jenkins Pipelines') {
      steps {
        echo "💾 Running Jenkins pipeline backup..."
        sh '''
          chmod +x scripts/backup/jenkins-backup.sh
          scripts/backup/jenkins-backup.sh backup-pipelines "${JENKINS_BACKUP}"
        '''
      }
    }

    stage('Commit & Push Changes') {
      steps {
        echo "📤 Committing and pushing backup changes..."
        withCredentials([usernamePassword(
          credentialsId: '7a5fcd35-3a38-4511-a275-881c11e6625d',
          usernameVariable: 'GIT_USER',
          passwordVariable: 'GIT_PASS'
        )]) {
          sh '''
            chmod +x scripts/common/git-operations.sh
            
            # Generate commit message with timestamp
            COMMIT_MSG="Backup ${HOST_NAME}: $(scripts/common/git-operations.sh timestamp)"
            
            # Execute git workflow
            scripts/common/git-operations.sh workflow \
              "$COMMIT_MSG" \
              "$GIT_USER" \
              "$GIT_PASS" \
              "${HASS_LOCAL}" \
              "${DASHY_LOCAL}" \
              "${GRAFANA_LOCAL}" \
              "${JENKINS_BACKUP}"
          '''
        }
      }
    }
  }

  post {
    success { 
      echo "✅ Backup completed successfully." 
    }
    failure { 
      echo "❌ Backup failed - check logs for details." 
    }
    always {
      echo "🏁 Backup pipeline finished."
    }
  }
}
