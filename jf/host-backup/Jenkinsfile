// Jenkins pipeline: Host-based Configuration Backup
// Uses jf/scripts/backup_configs_host.sh to fetch backups from a docker-compose homelab host

pipeline {
  agent { label 'slave' }

  parameters {
    choice(
      name: 'TARGET_HOST',
      choices: ['server', 'kubapc', 'drago', 'pimpek'],
      description: 'Select which host to backup'
    )
  }

  environment {
    INVENTORY_FILE = 'ansible/inventories/hosts.yml'
    HOST_NAME = "${params.TARGET_HOST ?: 'server'}"
    SSH_BASE = '/var/jenkins_home/.ssh'
    REMOTE_HOST = ''
    REMOTE_USER = ''

    HASS_LOCAL = 'hass-config'
    DASHY_LOCAL = 'dashy-config'
    GRAFANA_LOCAL = 'grafana-config'
    ADGUARD_LOCAL = 'adguard-config'
    OPENWEBUI_LOCAL = 'openwebui-config'

    PIPELINE_NAME = 'Host Configuration Backup'
    PIPELINE_VERSION = '1.0.0'
  }

  options {
    buildDiscarder(logRotator(numToKeepStr: '30'))
    timeout(time: 30, unit: 'MINUTES')
    skipStagesAfterUnstable()
  }

  stages {
    stage('Checkout') {
      steps {
        checkout scm
      }
    }

    stage('Detect Target') {
      steps {
        script {
          echo "=== DETECT TARGET STAGE START ==="
          echo "HOST_NAME from env: ${env.HOST_NAME}"
          echo "INVENTORY_FILE: ${env.INVENTORY_FILE}"

          // Parse inventory YAML manually (no Pipeline Utility Steps plugin needed)
          def inventoryContent = readFile(env.INVENTORY_FILE)
          echo "DEBUG: Inventory file read successfully, length: ${inventoryContent.length()}"

          echo "DEBUG: Looking for host: ${env.HOST_NAME}"

          // Simple line-by-line parsing
          def lines = inventoryContent.split('\n')
          echo "DEBUG: Total lines in inventory: ${lines.size()}"

          def hostLineIdx = lines.findIndexOf { it.trim().startsWith("${env.HOST_NAME}:") }
          echo "DEBUG: Host line index: ${hostLineIdx}"

          if (hostLineIdx >= 0) {
            echo "DEBUG: Found host at line ${hostLineIdx}"

            // Look at next few lines for ansible_host and ansible_user
            for (int i = hostLineIdx + 1; i < Math.min(hostLineIdx + 5, lines.size()); i++) {
              def line = lines[i].trim()
              echo "DEBUG: Line ${i}: '${line}'"

              if (line.startsWith('ansible_host:')) {
                def parts = line.split(':\\s*', 2)
                env.REMOTE_HOST = parts.length > 1 ? parts[1].trim() : ''
                echo "DEBUG: Found ansible_host: ${env.REMOTE_HOST}"
              }

              if (line.startsWith('ansible_user:')) {
                def parts = line.split(':\\s*', 2)
                env.REMOTE_USER = parts.length > 1 ? parts[1].trim() : ''
                echo "DEBUG: Found ansible_user: ${env.REMOTE_USER}"
              }

              // Stop if we hit another host or empty section
              if (line.endsWith(':') && !line.startsWith('ansible')) {
                echo "DEBUG: Stopping at next host definition"
                break
              }
            }

            if (!env.REMOTE_HOST || !env.REMOTE_USER) {
              error "Could not find ansible_host or ansible_user for '${env.HOST_NAME}'"
            }
          } else {
            error "Could not find host '${env.HOST_NAME}' in inventory"
          }

          echo "✓ Target: ${env.REMOTE_USER}@${env.REMOTE_HOST}"
        }
      }
    }

    stage('Run Host Backup Script') {
      steps {
        sh "chmod +x jf/scripts/backup_configs_host.sh"
        timeout(time: 20, unit: 'MINUTES') {
          sh './jf/scripts/backup_configs_host.sh'
        }
      }
    }

    stage('Commit and Push Backups') {
      steps {
        script {
          withCredentials([usernamePassword(credentialsId: '7a5fcd35-3a38-4511-a275-881c11e6625d', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_PASS')]) {
            sh '''
              git config user.email "jenkins@${HOST_NAME}.local"
              git config user.name "Jenkins Backup Service"
              ORIG_URL=$(git remote get-url origin)
              AUTH_URL=$(echo "$ORIG_URL" | sed -e "s#https://#https://${GIT_USER}:${GIT_PASS}@#")
              git remote set-url origin "$AUTH_URL"
            '''

            sh "git add ${HASS_LOCAL} ${DASHY_LOCAL} ${GRAFANA_LOCAL} ${ADGUARD_LOCAL} ${OPENWEBUI_LOCAL} || true"

            def hasChanges = sh(script: 'git diff --cached --quiet', returnStatus: true)
            if (hasChanges != 0) {
              def commitMessage = "Host backup ${env.HOST_NAME}: ${new Date().format('yyyy-MM-dd HH:mm:ss UTC')}"
              sh "git commit -m \"${commitMessage}\" || true"
              sh "git push origin HEAD:main"
            } else {
              echo 'No changes to commit.'
            }
          }
        }
      }
    }

  }

  post {
    always {
      archiveArtifacts artifacts: 'backup-report.md', allowEmptyArchive: true
    }
  }

}
