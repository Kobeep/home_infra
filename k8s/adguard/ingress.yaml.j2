# Ingress dla AdGuard - adguard.{{ server_ip }}.nip.io
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: adguard-ingress
  namespace: adguard
  annotations:
    cert-manager.io/cluster-issuer: local-ca
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
spec:
  ingressClassName: nginx
  rules:
  - host: adguard.{{ server_ip }}.nip.io
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: adguard
            port:
              number: 3000
  tls:
  - hosts:
    - adguard.{{ server_ip }}.nip.io
    secretName: adguard-tls
