# Ingress dla InfluxDB - influxdb.{{ server_ip }}.nip.io
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: influxdb-ingress
  namespace: influxdb
  annotations:
    cert-manager.io/cluster-issuer: local-ca
    nginx.ingress.kubernetes.io/ssl-redirect: "true"
spec:
  ingressClassName: nginx
  rules:
  - host: influxdb.{{ server_ip }}.nip.io
    http:
      paths:
      - path: /
        pathType: Prefix
        backend:
          service:
            name: influxdb
            port:
              number: 8086
  tls:
  - hosts:
    - influxdb.{{ server_ip }}.nip.io
    secretName: influxdb-tls
