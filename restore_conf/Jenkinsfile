/**
 * Configuration Restore Pipeline
 * 
 * Restores configurations to home infrastructure services including
 * Home Assistant, Grafana, Dashy, AdGuard Home, and OpenWebUI.
 * 
 * Features:
 * - Automated restore of multiple services
 * - Secure SSH connection management  
 * - Comprehensive error handling and logging
 * - Service health verification after restore
 * - Professional CI/CD practices
 * 
 * @version 2.0.0
 * @author Jenkins CI
 */

@Library('homeInfraUtils') _

pipeline {
    agent { 
        label 'slave' 
    }

    environment {
        // Standard configuration
        INVENTORY_FILE = 'ansible/inventories/hosts.yml'
        HOST_NAME = 'server'
        SSH_BASE = '/var/jenkins_home/.ssh'
        REMOTE_KUBECONFIG = '/etc/rancher/k3s/k3s.yaml'
        
        // Configuration directories
        HASS_LOCAL = 'hass-config'
        DASHY_LOCAL = 'dashy-config'
        GRAFANA_LOCAL = 'grafana-config'
        ADGUARD_LOCAL = 'adguard-config'
        OPENWEBUI_LOCAL = 'openwebui-config'
        
        // Pipeline metadata
        PIPELINE_VERSION = '2.0.0'
        PIPELINE_NAME = 'Configuration Restore'
    }

    parameters {
        booleanParam(
            name: 'RESTORE_HOME_ASSISTANT',
            defaultValue: true,
            description: 'Restore Home Assistant configuration'
        )
        booleanParam(
            name: 'RESTORE_DASHY',
            defaultValue: true,
            description: 'Restore Dashy dashboard configuration'
        )
        booleanParam(
            name: 'RESTORE_GRAFANA',
            defaultValue: true,
            description: 'Restore Grafana configuration'
        )
        booleanParam(
            name: 'RESTORE_ADGUARD',
            defaultValue: true,
            description: 'Restore AdGuard Home configuration'
        )
        booleanParam(
            name: 'RESTORE_OPENWEBUI',
            defaultValue: true,
            description: 'Restore OpenWebUI configuration'
        )
        booleanParam(
            name: 'VERIFY_SERVICES',
            defaultValue: true,
            description: 'Verify services are running after restore'
        )
    }

    options {
        // Build configuration
        buildDiscarder(logRotator(numToKeepStr: '20'))
        timeout(time: 45, unit: 'MINUTES')
        skipStagesAfterUnstable()
        
        // Enhanced logging
        ansiColor('xterm')
        timestamps()
    }

    stages {
        stage('Initialize Restore Process') {
            steps {
                script {
                    echo "🚀 Starting ${env.PIPELINE_NAME} v${env.PIPELINE_VERSION}"
                    echo "🏠 Target Host: ${env.HOST_NAME}"
                    echo "📅 Restore Date: ${new Date().format('yyyy-MM-dd HH:mm:ss UTC')}"
                    
                    // Log selected restore options
                    def selectedServices = []
                    if (params.RESTORE_HOME_ASSISTANT) selectedServices.add("Home Assistant")
                    if (params.RESTORE_DASHY) selectedServices.add("Dashy")
                    if (params.RESTORE_GRAFANA) selectedServices.add("Grafana")
                    if (params.RESTORE_ADGUARD) selectedServices.add("AdGuard Home")
                    if (params.RESTORE_OPENWEBUI) selectedServices.add("OpenWebUI")
                    
                    if (selectedServices.isEmpty()) {
                        error "❌ No services selected for restore. Please select at least one service."
                    }
                    
                    echo "📋 Services to restore: ${selectedServices.join(', ')}"
                    echo "🔍 Service verification: ${params.VERIFY_SERVICES ? 'Enabled' : 'Disabled'}"
                    
                    echo "✅ Restore process initialization completed"
                }
            }
        }

        stage('Checkout Repository') {
            steps {
                echo "📥 Checking out repository..."
                checkout scm
                
                script {
                    // Verify required files exist
                    def requiredFiles = [env.INVENTORY_FILE, "restore_conf/scripts/restore_configs.sh"]
                    requiredFiles.each { file ->
                        if (!fileExists(file)) {
                            error "❌ Required file not found: ${file}"
                        }
                    }
                    
                    // Verify backup data exists for selected services
                    def missingBackups = []
                    if (params.RESTORE_HOME_ASSISTANT && !fileExists(env.HASS_LOCAL)) {
                        missingBackups.add("Home Assistant (${env.HASS_LOCAL})")
                    }
                    if (params.RESTORE_DASHY && !fileExists("${env.DASHY_LOCAL}/conf.yml")) {
                        missingBackups.add("Dashy (${env.DASHY_LOCAL}/conf.yml)")
                    }
                    if (params.RESTORE_GRAFANA && !fileExists(env.GRAFANA_LOCAL)) {
                        missingBackups.add("Grafana (${env.GRAFANA_LOCAL})")
                    }
                    if (params.RESTORE_ADGUARD && !fileExists(env.ADGUARD_LOCAL)) {
                        missingBackups.add("AdGuard Home (${env.ADGUARD_LOCAL})")
                    }
                    if (params.RESTORE_OPENWEBUI && !fileExists(env.OPENWEBUI_LOCAL)) {
                        missingBackups.add("OpenWebUI (${env.OPENWEBUI_LOCAL})")
                    }
                    
                    if (missingBackups) {
                        error "❌ Missing backup data for: ${missingBackups.join(', ')}"
                    }
                    
                    echo "✅ Repository checkout and backup data validation completed"
                }
            }
        }

        stage('Parse Target Host Configuration') {
            steps {
                script {
                    try {
                        echo "🔍 Parsing inventory for restore target: ${env.HOST_NAME}"
                        
                        def inv = readYaml file: env.INVENTORY_FILE
                        def hostEntry = inv.all.children.values()
                            .find { it.hosts?.containsKey(env.HOST_NAME) }
                            ?.hosts[env.HOST_NAME]
                            
                        if (!hostEntry) {
                            error "❌ Host '${env.HOST_NAME}' not found in inventory"
                        }
                        
                        // Validate required host configuration
                        homeInfraUtils.validateParameters([
                            ansible_host: hostEntry.ansible_host,
                            ansible_user: hostEntry.ansible_user
                        ])
                        
                        env.REMOTE_HOST = hostEntry.ansible_host
                        env.REMOTE_USER = hostEntry.ansible_user
                        
                        echo "✅ Target host configuration parsed:"
                        echo "   Host: ${env.HOST_NAME}"
                        echo "   IP: ${env.REMOTE_HOST}"
                        echo "   User: ${env.REMOTE_USER}"
                        
                    } catch (Exception e) {
                        error "❌ Failed to parse target host configuration: ${e.getMessage()}"
                    }
                }
            }
        }

        stage('Pre-Restore Health Check') {
            when {
                expression { params.VERIFY_SERVICES }
            }
            steps {
                script {
                    echo "🩺 Performing pre-restore health check..."
                    
                    try {
                        // Test SSH connectivity
                        def sshTest = sh(
                            script: """
                                ssh -i ${env.SSH_BASE}/${env.HOST_NAME}/id_rsa \
                                    -o StrictHostKeyChecking=no \
                                    -o ConnectTimeout=10 \
                                    ${env.REMOTE_USER}@${env.REMOTE_HOST} \
                                    'echo "SSH_OK"'
                            """,
                            returnStatus: true
                        )
                        
                        if (sshTest != 0) {
                            error "❌ SSH connectivity test failed"
                        }
                        
                        // Test Kubernetes connectivity
                        def k8sTest = sh(
                            script: """
                                ssh -i ${env.SSH_BASE}/${env.HOST_NAME}/id_rsa \
                                    -o StrictHostKeyChecking=no \
                                    ${env.REMOTE_USER}@${env.REMOTE_HOST} \
                                    'sudo env KUBECONFIG=${env.REMOTE_KUBECONFIG} kubectl cluster-info'
                            """,
                            returnStatus: true
                        )
                        
                        if (k8sTest != 0) {
                            error "❌ Kubernetes cluster connectivity test failed"
                        }
                        
                        echo "✅ Pre-restore health check passed"
                        
                    } catch (Exception e) {
                        error "❌ Pre-restore health check failed: ${e.getMessage()}"
                    }
                }
            }
        }

        stage('Execute Configuration Restore') {
            steps {
                script {
                    try {
                        echo "🔄 Starting configuration restore process..."
                        
                        // Make restore script executable
                        sh "chmod +x restore_conf/scripts/restore_configs.sh"
                        
                        // Execute restore script with timeout
                        timeout(time: 30, unit: 'MINUTES') {
                            def restoreResult = sh(
                                script: "./restore_conf/scripts/restore_configs.sh",
                                returnStatus: true
                            )
                            
                            if (restoreResult != 0) {
                                error "❌ Configuration restore script failed with exit code: ${restoreResult}"
                            }
                        }
                        
                        echo "✅ Configuration restore completed successfully"
                        
                    } catch (Exception e) {
                        error "❌ Configuration restore failed: ${e.getMessage()}"
                    }
                }
            }
        }

        stage('Post-Restore Service Verification') {
            when {
                expression { params.VERIFY_SERVICES }
            }
            steps {
                script {
                    echo "🔍 Verifying services after restore..."
                    
                    def servicesToCheck = []
                    if (params.RESTORE_HOME_ASSISTANT) servicesToCheck.add(['home', 'home-assistant'])
                    if (params.RESTORE_DASHY) servicesToCheck.add(['monitoring', 'dashy'])
                    if (params.RESTORE_GRAFANA) servicesToCheck.add(['monitoring', 'grafana'])
                    if (params.RESTORE_ADGUARD) servicesToCheck.add(['default', 'adguardhome'])
                    if (params.RESTORE_OPENWEBUI) servicesToCheck.add(['ai', 'openwebui'])
                    
                    def healthyServices = []
                    def unhealthyServices = []
                    
                    servicesToCheck.each { service ->
                        def namespace = service[0]
                        def serviceName = service[1]
                        
                        try {
                            echo "🔍 Checking ${serviceName} in namespace ${namespace}..."
                            
                            def podStatus = sh(
                                script: """
                                    ssh -i ${env.SSH_BASE}/${env.HOST_NAME}/id_rsa \
                                        -o StrictHostKeyChecking=no \
                                        ${env.REMOTE_USER}@${env.REMOTE_HOST} \
                                        'sudo env KUBECONFIG=${env.REMOTE_KUBECONFIG} kubectl -n ${namespace} get pods -l app=${serviceName} --no-headers | head -1 | awk "{print \\$3}"'
                                """,
                                returnStdout: true
                            ).trim()
                            
                            if (podStatus == "Running") {
                                healthyServices.add("${serviceName} (${namespace})")
                                echo "   ✅ ${serviceName} is running"
                            } else {
                                unhealthyServices.add("${serviceName} (${namespace}) - Status: ${podStatus}")
                                echo "   ⚠️  ${serviceName} status: ${podStatus}"
                            }
                            
                        } catch (Exception e) {
                            unhealthyServices.add("${serviceName} (${namespace}) - Error: ${e.getMessage()}")
                            echo "   ❌ Failed to check ${serviceName}: ${e.getMessage()}"
                        }
                    }
                    
                    echo "📊 Service Health Summary:"
                    echo "   Healthy: ${healthyServices.join(', ')}"
                    if (unhealthyServices) {
                        echo "   Unhealthy: ${unhealthyServices.join(', ')}"
                        echo "⚠️  Some services may need time to restart after configuration restore"
                    }
                }
            }
        }

        stage('Generate Restore Report') {
            steps {
                script {
                    try {
                        echo "📋 Generating restore report..."
                        
                        def reportLines = []
                        reportLines.add("# Configuration Restore Report - ${new Date().format('yyyy-MM-dd HH:mm:ss UTC')}")
                        reportLines.add("")
                        reportLines.add("## Services Restored:")
                        
                        if (params.RESTORE_HOME_ASSISTANT) reportLines.add("- ✅ **Home Assistant**: Configuration restored")
                        if (params.RESTORE_DASHY) reportLines.add("- ✅ **Dashy**: Dashboard configuration restored")
                        if (params.RESTORE_GRAFANA) reportLines.add("- ✅ **Grafana**: Monitoring configuration restored")
                        if (params.RESTORE_ADGUARD) reportLines.add("- ✅ **AdGuard Home**: DNS filtering configuration restored")
                        if (params.RESTORE_OPENWEBUI) reportLines.add("- ✅ **OpenWebUI**: AI interface configuration restored")
                        
                        reportLines.add("")
                        reportLines.add("## Restore Details:")
                        reportLines.add("- Target Host: ${env.HOST_NAME} (${env.REMOTE_HOST})")
                        reportLines.add("- Duration: ${currentBuild.durationString}")
                        reportLines.add("- Jenkins Build: #${env.BUILD_NUMBER}")
                        reportLines.add("- Service Verification: ${params.VERIFY_SERVICES ? 'Enabled' : 'Disabled'}")
                        
                        reportLines.add("")
                        reportLines.add("## Post-Restore Notes:")
                        reportLines.add("- Services may take a few minutes to fully restart after configuration restore")
                        reportLines.add("- Check individual service logs if any issues are encountered")
                        reportLines.add("- Some services may require manual restart if pods don't automatically restart")
                        
                        // Write report to file
                        writeFile file: 'restore-report.md', text: reportLines.join('\n')
                        
                        // Display report in console
                        echo "📊 Restore Report:"
                        reportLines.each { line -> echo line }
                        
                    } catch (Exception e) {
                        echo "⚠️  Failed to generate restore report (non-critical): ${e.getMessage()}"
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                def duration = currentBuild.durationString.replace(' and counting', '')
                echo "📊 ${env.PIPELINE_NAME} completed in ${duration}"
                echo "📋 Build result: ${currentBuild.result ?: 'SUCCESS'}"
                echo "🏠 Target: ${env.HOST_NAME}"
                
                // Archive the restore report
                if (fileExists('restore-report.md')) {
                    archiveArtifacts artifacts: 'restore-report.md', fingerprint: true
                }
            }
        }
        
        success {
            echo "✅ Configuration restore completed successfully"
            echo "🎉 Selected service configurations have been restored"
            echo "💡 Services may take a few minutes to fully restart with the restored configurations"
        }
        
        failure {
            echo "❌ Configuration restore failed"
            echo "🔍 Check the logs above for detailed error information"
            echo "💡 Common issues:"
            echo "   - SSH connectivity to target host"
            echo "   - Kubernetes cluster accessibility"
            echo "   - Pod permission issues"
            echo "   - Service dependencies not ready"
            echo "   - Configuration file format issues"
        }
        
        unstable {
            echo "⚠️  Configuration restore completed with warnings"
            echo "📋 Some services may not have been restored successfully"
            echo "🔍 Check service verification results for details"
        }
        
        cleanup {
            script {
                // Clean up sensitive environment variables
                env.REMOTE_HOST = null
                env.REMOTE_USER = null
                
                // Standard pipeline cleanup
                homeInfraUtils.cleanup()
                
                echo "🧹 Pipeline cleanup completed"
            }
        }
    }
}