pipeline {
    agent { label 'slave' }

    parameters {
        string(name: 'TARGET_HOST', defaultValue: '', description: 'Target Windows host from inventory')
        string(name: 'PLAYBOOK', defaultValue: '', description: 'Windows playbook to run (e.g. win_apps_deploy.yml)')
        password(name: 'WINRM_PASS', defaultValue: '', description: 'WinRM password for the target host')
    }

    environment {
        INVENTORY_FILE = 'ansible/inventories/hosts.yml'
        PLAYBOOKS_DIR  = 'ansible/playbooks'
        TARGET_GROUP   = 'windows'
    }

    options {
        timestamps()
        timeout(time: 30, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        ansiColor('xterm')
    }

    stages {
        stage('Pre-flight Checks') {
            steps {
                script {
                    echo "🔍 Performing pre-flight checks for Windows deployment..."
                    
                    // Validate required parameters
                    validateParameters(params, ['TARGET_HOST', 'PLAYBOOK', 'WINRM_PASS'])
                    
                    // Check if inventory file exists
                    if (!fileExists(env.INVENTORY_FILE)) {
                        error "❌ Inventory file not found: ${env.INVENTORY_FILE}"
                    }
                    
                    // Check if playbook exists
                    def playbookPath = "${env.PLAYBOOKS_DIR}/${params.PLAYBOOK}"
                    if (!fileExists(playbookPath)) {
                        error "❌ Playbook not found: ${playbookPath}"
                    }
                    
                    echo "✅ Pre-flight checks completed successfully"
                }
            }
        }

        stage('Checkout Repository') {
            steps {
                echo "📥 Checking out repository for Windows deployment..."
                checkout scm
            }
        }

        stage('Parse Windows Inventory') {
            steps {
                script {
                    echo "🔍 Parsing inventory for Windows host: ${params.TARGET_HOST}"
                    
                    // Use shared library function for inventory parsing
                    def hostConfig = parseInventory(env.INVENTORY_FILE, params.TARGET_HOST, env.TARGET_GROUP)

                    env.TARGET_IP   = hostConfig.ansible_host
                    env.REMOTE_USER = hostConfig.ansible_user

                    echo "➡ Windows Host: ${params.TARGET_HOST}"
                    echo "➡ IP: ${env.TARGET_IP}"
                    echo "➡ Remote user: ${env.REMOTE_USER}"
                }
            }
        }

        stage('Test WinRM Connection') {
            steps {
                script {
                    echo "🔗 Testing WinRM connection to ${params.TARGET_HOST}..."
                    
                    timeout(time: 2, unit: 'MINUTES') {
                        retry(3) {
                            sh """
                                ansible ${params.TARGET_HOST} \
                                    -i ${env.INVENTORY_FILE} \
                                    -m win_ping \
                                    -e "ansible_password=${params.WINRM_PASS}" \
                                    --timeout=30
                            """
                        }
                    }
                    
                    echo "✅ WinRM connection established successfully"
                }
            }
        }

        stage('Run Ansible Playbook for Windows') {
            steps {
                script {
                    echo "🚀 Running Windows playbook: ${params.PLAYBOOK} on host ${params.TARGET_HOST}"
                    
                    timeout(time: 20, unit: 'MINUTES') {
                        dir(env.PLAYBOOKS_DIR) {
                            sh """
                                set -e
                                echo "📋 Validating playbook syntax..."
                                ansible-playbook --syntax-check -i ../inventories/hosts.yml ${params.PLAYBOOK}
                                
                                echo "🎯 Executing Windows playbook with verbose output..."
                                ansible-playbook \
                                    -i ../inventories/hosts.yml \
                                    ${params.PLAYBOOK} \
                                    --limit ${params.TARGET_HOST} \
                                    -e "ansible_password=${params.WINRM_PASS}" \
                                    -v \
                                    --diff
                            """
                        }
                    }
                    
                    echo "✅ Windows playbook execution completed successfully"
                }
            }
        }
    }

    post {
        always {
            script {
                def duration = currentBuild.duration ? currentBuild.duration / 1000 : 'unknown'
                echo "📊 Windows deployment finished in ${duration} seconds"
            }
        }
        success {
            echo "✅ Windows deployment completed successfully for ${params.TARGET_HOST}"
        }
        failure {
            echo "❌ Windows deployment failed for ${params.TARGET_HOST}"
        }
        unstable {
            echo "⚠️ Windows deployment completed with warnings for ${params.TARGET_HOST}"
        }
    }
}
